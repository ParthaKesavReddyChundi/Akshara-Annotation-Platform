# ── Backend ────────────────────────────────────────────────────────────────────
# Application
APP_NAME="Akshara Annotation Platform"
APP_VERSION="2.0.0"
ENVIRONMENT="development"
DEBUG=false

# Database (Phase 1: SQLite; Phase 2: Replace with Supabase Postgres URL)
DATABASE_URL="sqlite:///./streamlit_app/akshara.db"

# JWT Authentication
JWT_SECRET_KEY="REPLACE_WITH_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — comma-separated allowed frontend origins
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Task Locking
TASK_LOCK_TIMEOUT_MINUTES=30
TASK_LOCK_HEARTBEAT_INTERVAL_SECONDS=60

# ── Supabase (Phase 2+) ────────────────────────────────────────────────────────
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_KEY=""
STORAGE_BUCKET="audio-files"
AUDIO_URL_EXPIRY_SECONDS=3600

# ── Frontend (fill in during Phase 5) ─────────────────────────────────────────
# VITE_API_BASE_URL="http://localhost:8000"
